<!-- ================= PILLARS ================= -->
<section class="sec" id="how" data-scene="2">
  <div class="wrap">
    <div class="pillars">
      {% for block in section.blocks %}
        {% assign d_class = "" %}
        {% if forloop.index == 2 %}{% assign d_class = "rv-d2" %}{% endif %}
        {% if forloop.index == 3 %}{% assign d_class = "rv-d3" %}{% endif %}
        
        <article class="glass pillar rv {{ d_class }}" {{ block.shopify_attributes }}>
          <span class="pi">
            {{ block.settings.svg_icon }}
          </span>
          <h3 class="d3">{{ block.settings.heading }}</h3>
          <p class="body-s">{{ block.settings.text }}</p>
          <a class="btn btn-ghost btn-sm" href="{{ block.settings.btn_link }}">{{ block.settings.btn_text }}</a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane How it works",
  "settings": [],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "textarea",
          "id": "svg_icon",
          "label": "SVG Icon HTML",
          "default": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"8\" cy=\"8.5\" r=\"3.2\"/><circle cx=\"16.4\" cy=\"6.6\" r=\"2.2\"/><circle cx=\"15\" cy=\"13\" r=\"2.8\"/><circle cx=\"8.6\" cy=\"15.6\" r=\"2.1\"/><path d=\"M4 21h16\"/></svg>"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Less scrubbing"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub."
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Text",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane How it works"
    }
  ]
}
{% endschema %}
