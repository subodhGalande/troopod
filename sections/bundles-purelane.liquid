{{ 'purelane.css' | asset_url | stylesheet_tag }}

<!-- ================= BUNDLES ================= -->
<section class="sec" id="bundles" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">{{ section.settings.kicker }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
        <p class="lede" style="margin:0 auto">{{ section.settings.lede }}</p>
      </div>
    </div>
    <div class="tiers">
      {% for block in section.blocks %}
        {% render 'bundle-tier-purelane', block: block %}
      {% endfor %}
    </div>
  </div>

  {% if section.settings.bundle_collection != blank %}
    {% render 'bundle-drawer-purelane', collection: collections[section.settings.bundle_collection] %}
  {% endif %}
</section>

{% schema %}
{
  "name": "Bundles - Purelane",
  "settings": [
    {
      "type": "collection",
      "id": "bundle_collection",
      "label": "Bundle Products Collection",
      "info": "Select the collection of products customers can choose from when building a bundle."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lead Text",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Pricing Tier",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Starter"
        },
        {
          "type": "text",
          "id": "qty_number",
          "label": "Quantity Number",
          "default": "2"
        },
        {
          "type": "text",
          "id": "qty_text",
          "label": "Quantity Text",
          "default": "Products"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹349"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare Price",
          "default": "₹598"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Flat ₹174 per product"
        },
        {
          "type": "text",
          "id": "svg_icons",
          "label": "SVG CSS Classes (comma-separated)",
          "default": "p-combo2",
          "info": "e.g. 'p-combo2' or 'p-kitchen, p-tap, p-dish'"
        },
        {
          "type": "text",
          "id": "feature_1",
          "label": "Feature 1",
          "default": "Pick any two products"
        },
        {
          "type": "text",
          "id": "feature_2",
          "label": "Feature 2",
          "default": "Free shipping across India"
        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Feature 3"
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Text",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "btn_url",
          "label": "Button Link"
        },
        {
          "type": "checkbox",
          "id": "is_popular",
          "label": "Highlight as Popular",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundles - Purelane",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "title": "Starter",
            "qty_number": "2",
            "price": "₹349",
            "compare_price": "₹598",
            "subtitle": "Flat ₹174 per product",
            "svg_icons": "p-combo2",
            "feature_1": "Pick any two products",
            "feature_2": "Free shipping across India",
            "btn_text": "Build this box"
          }
        },
        {
          "type": "tier",
          "settings": {
            "title": "Most popular",
            "qty_number": "3",
            "price": "₹499",
            "compare_price": "₹897",
            "subtitle": "Flat ₹166 per product",
            "svg_icons": "p-kitchen, p-tap, p-dish",
            "feature_1": "Pick any three products",
            "feature_2": "Covers kitchen and laundry",
            "feature_3": "Free shipping across India",
            "btn_text": "Build this box",
            "is_popular": true
          }
        },
        {
          "type": "tier",
          "settings": {
            "title": "Whole home",
            "qty_number": "5",
            "price": "₹799",
            "compare_price": "₹1495",
            "subtitle": "Flat ₹160 per product",
            "svg_icons": "p-kitchen, p-tap, p-floor, p-toilet, p-laundry",
            "feature_1": "Pick any five products",
            "feature_2": "Every room in one order",
            "feature_3": "Free shipping across India",
            "btn_text": "Build this box"
          }
        }
      ]
    }
  ]
}
{% endschema %}
