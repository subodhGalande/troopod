{{ 'purelane.css' | asset_url | stylesheet_tag }}

<section class="sec" id="shop" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>
    
    <div class="shelf">
      {% assign d_classes = ",rv-d1,rv-d2,rv-d3,rv-d4,rv-d5,rv-d6,rv-d7" | split: "," %}
      {% assign grid_products = section.settings.collection.products %}
      {% if grid_products == blank %}
        {% assign grid_products = collections['all'].products %}
      {% endif %}

      {% for product in grid_products limit: section.settings.products_to_show %}
        {% assign idx = forloop.index0 | modulo: 8 %}
        {% render 'product-card-purelane', product: product, card_class: d_classes[idx] %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop Grid - Purelane",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 8,
      "label": "Maximum products to show"
    }
  ],
  "presets": [
    {
      "name": "Shop Grid - Purelane",
      "category": "Purelane"
    }
  ]
}
{% endschema %}
