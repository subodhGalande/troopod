{% comment %}
  PURELANE PILLARS / HOW IT WORKS (1:1 PARITY WITH PROTOTYPE)
{% endcomment %}

{{ 'purelane.css' | asset_url | stylesheet_tag }}

<style>
  .pillars{display:grid;gap:16px;grid-template-columns:1fr}
  @media(min-width:820px){.pillars{grid-template-columns:repeat(3,1fr)}}
  .pillar{padding:26px 24px 24px;display:flex;flex-direction:column}
  .pillar .pi{width:50px;height:50px;border-radius:15px;display:grid;place-items:center;margin-bottom:16px;
    background:linear-gradient(150deg,rgba(201,118,29,.18),rgba(75,58,143,.12));border:1px solid rgba(75,58,143,.16);color:#4f7d10}
  .pillar .pi svg{width:24px;height:24px}
  .pillar .d3{margin-bottom:11px}
  .pillar p{margin-bottom:20px;flex:1}
  .pillar .btn{align-self:flex-start}
</style>

<section class="sec" id="how" data-scene="2">
  <div class="wrap">
    <div class="pillars">
      <article class="glass pillar">
        <span class="pi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8.5" r="3.2"/><circle cx="16.4" cy="6.6" r="2.2"/><circle cx="15" cy="13" r="2.8"/><circle cx="8.6" cy="15.6" r="2.1"/><path d="M4 21h16"/></svg>
        </span>
        <h3 class="d3">Less scrubbing</h3>
        <p class="body-s">A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub.</p>
        <a class="btn btn-ghost btn-sm" href="#shop">Learn more</a>
      </article>
      
      <article class="glass pillar">
        <span class="pi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
        </span>
        <h3 class="d3">Clean ingredients</h3>
        <p class="body-s">No sulphates, no chlorine, no synthetic fragrance. Nothing on the label you would not want near your food.</p>
        <a class="btn btn-ghost btn-sm" href="#ingredients">Learn more</a>
      </article>
      
      <article class="glass pillar">
        <span class="pi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z"/></svg>
        </span>
        <h3 class="d3">Safe around everyone</h3>
        <p class="body-s">Gentle on hands, safe around kids and pets, and it leaves no toxic residue on the surfaces you touch every day.</p>
        <a class="btn btn-ghost btn-sm" href="#proof">Learn more</a>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Pillars",
  "presets": [
    {
      "name": "Purelane Pillars"
    }
  ]
}
{% endschema %}
