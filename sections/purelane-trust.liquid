<!-- ================= WHY BUNDLES BEAT BUYING SINGLE ================= -->
<section class="sec" id="whybundles" data-scene="4">
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="panel-head">
        <span class="kicker">{{ section.settings.wb_kicker }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.wb_heading }}</h2>
      </div>
      <div class="wb">
        <div class="wb-i">
          <span class="ci"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M16.5 7.2C15.6 6 14 5.4 12 5.4c-2.4 0-4 1.1-4 2.9 0 2 1.7 2.7 4.2 3.3 2.7.6 4.3 1.4 4.3 3.4 0 1.9-1.7 3.1-4.5 3.1-2.2 0-3.8-.7-4.8-2"/></svg></span>
          <h4>{{ section.settings.wb_title_1 }}</h4><p>{{ section.settings.wb_text_1 }}</p>
        </div>
        <div class="wb-i">
          <span class="ci"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="3.4"/><path d="m8.4 12.2 2.4 2.4 4.8-5"/></svg></span>
          <h4>{{ section.settings.wb_title_2 }}</h4><p>{{ section.settings.wb_text_2 }}</p>
        </div>
        <div class="wb-i">
          <span class="ci"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8L3.6 9.7l5.8-.8Z"/></svg></span>
          <h4>{{ section.settings.wb_title_3 }}</h4><p>{{ section.settings.wb_text_3 }}</p>
        </div>
        <div class="wb-i">
          <span class="ci"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2.6 16.4V7.2h10.2v9.2"/><path d="M12.8 10.4h4l3.6 3.2v2.8h-7.6"/><circle cx="6.6" cy="18" r="1.9"/><circle cx="16.6" cy="18" r="1.9"/></svg></span>
          <h4>{{ section.settings.wb_title_4 }}</h4><p>{{ section.settings.wb_text_4 }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= FIND THE RIGHT BUNDLE ================= -->
<section class="sec" id="categories" data-scene="4">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.cat_kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.cat_heading }}</h2>
    </div>
    <div class="cats">
      <a class="glass cat rv" href="#combos"><span class="ph"><span class="pimg p-kitchen" role="img" aria-label="Purelane foaming kitchen cleaner"></span></span><span class="txt"><h4>{{ section.settings.cat_title_1 }}</h4><p>{{ section.settings.cat_text_1 }}</p></span></a>
      <a class="glass cat rv rv-d1" href="#combos"><span class="ph"><span class="pimg p-toilet" role="img" aria-label="Purelane non-toxic toilet cleaner"></span></span><span class="txt"><h4>{{ section.settings.cat_title_2 }}</h4><p>{{ section.settings.cat_text_2 }}</p></span></a>
      <a class="glass cat rv rv-d2" href="#combos"><span class="ph"><span class="pimg p-laundry" role="img" aria-label="Purelane non-toxic laundry detergent"></span></span><span class="txt"><h4>{{ section.settings.cat_title_3 }}</h4><p>{{ section.settings.cat_text_3 }}</p></span></a>
      <a class="glass cat rv rv-d3" href="#combos"><span class="ph"><span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner and limescale remover"></span></span><span class="txt"><h4>{{ section.settings.cat_title_4 }}</h4><p>{{ section.settings.cat_text_4 }}</p></span></a>
    </div>
  </div>
</section>

<!-- ================= TRUST BAR ================= -->
<section class="sec" data-scene="4">
  <div class="wrap">
    <div class="glass trust rv">
      <div class="trust-i">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <span>{{ section.settings.trust_1 }}</span>
      </div>
      <div class="trust-i">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h16v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/><path d="M4 8 6.5 3h11L20 8M9.5 12h5"/></svg>
        <span>{{ section.settings.trust_2 }}</span>
      </div>
      <div class="trust-i">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z"/></svg>
        <span>{{ section.settings.trust_3 }}</span>
      </div>
      <div class="trust-i">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.6"/><path d="M3.4 12h17.2M12 3.4c2.4 2.4 3.6 5.4 3.6 8.6S14.4 18.2 12 20.6c-2.4-2.4-3.6-5.4-3.6-8.6S9.6 5.8 12 3.4Z"/></svg>
        <span>{{ section.settings.trust_4 }}</span>
      </div>
    </div>
  </div>
</section>

<!-- ================= SIGNUP ================= -->
<section class="sec" data-scene="4">
  <div class="wrap">
    <div class="glass signup rv">
      <span class="kicker">{{ section.settings.signup_kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.signup_heading }}</h2>
      <p class="lede" style="margin:0 auto">{{ section.settings.signup_lede }}</p>
      <form onsubmit="return false">
        <input type="email" placeholder="your@email.com" aria-label="Email address" required>
        <button class="btn btn-primary" type="submit">{{ section.settings.signup_btn }}</button>
      </form>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Trust Elements",
  "settings": [
    {
      "type": "header",
      "content": "Why Bundles"
    },
    { "type": "text", "id": "wb_kicker", "label": "Kicker", "default": "The smarter way to shop" },
    { "type": "text", "id": "wb_heading", "label": "Heading", "default": "Why bundles beat buying single" },
    { "type": "text", "id": "wb_title_1", "label": "Feature 1 Title", "default": "Save up to 45%" },
    { "type": "text", "id": "wb_text_1", "label": "Feature 1 Text", "default": "Versus buying the same products separately" },
    { "type": "text", "id": "wb_title_2", "label": "Feature 2 Title", "default": "One flat price" },
    { "type": "text", "id": "wb_text_2", "label": "Feature 2 Text", "default": "No calculators, no comparing carts" },
    { "type": "text", "id": "wb_title_3", "label": "Feature 3 Title", "default": "Curated by experts" },
    { "type": "text", "id": "wb_text_3", "label": "Feature 3 Text", "default": "Products picked to work well together" },
    { "type": "text", "id": "wb_title_4", "label": "Feature 4 Title", "default": "Free shipping always" },
    { "type": "text", "id": "wb_text_4", "label": "Feature 4 Text", "default": "Included on every bundle, all India" },
    
    {
      "type": "header",
      "content": "Categories"
    },
    { "type": "text", "id": "cat_kicker", "label": "Kicker", "default": "Bundle categories" },
    { "type": "text", "id": "cat_heading", "label": "Heading", "default": "Find the right bundle for you" },
    { "type": "text", "id": "cat_title_1", "label": "Category 1 Title", "default": "Kitchen bundle" },
    { "type": "text", "id": "cat_text_1", "label": "Category 1 Text", "default": "Grease, dishes & more" },
    { "type": "text", "id": "cat_title_2", "label": "Category 2 Title", "default": "Bathroom bundle" },
    { "type": "text", "id": "cat_text_2", "label": "Category 2 Text", "default": "Deep clean & disinfect" },
    { "type": "text", "id": "cat_title_3", "label": "Category 3 Title", "default": "Laundry bundle" },
    { "type": "text", "id": "cat_text_3", "label": "Category 3 Text", "default": "Softer, fresher wash" },
    { "type": "text", "id": "cat_title_4", "label": "Category 4 Title", "default": "Hard water bundle" },
    { "type": "text", "id": "cat_text_4", "label": "Category 4 Text", "default": "Melt away limescale" },
    
    {
      "type": "header",
      "content": "Trust Icons"
    },
    { "type": "textarea", "id": "trust_1", "label": "Icon 1", "default": "Plant derived<br>formulas" },
    { "type": "textarea", "id": "trust_2", "label": "Icon 2", "default": "Recyclable<br>packaging" },
    { "type": "textarea", "id": "trust_3", "label": "Icon 3", "default": "Safe for<br>kids & pets" },
    { "type": "textarea", "id": "trust_4", "label": "Icon 4", "default": "Made in<br>India" },
    
    {
      "type": "header",
      "content": "Email Signup"
    },
    { "type": "text", "id": "signup_kicker", "label": "Kicker", "default": "Join the Purelane Club" },
    { "type": "text", "id": "signup_heading", "label": "Heading", "default": "Get ₹100 off your first bundle" },
    { "type": "textarea", "id": "signup_lede", "label": "Lead Text", "default": "Plus first access to new launches and restocks." },
    { "type": "text", "id": "signup_btn", "label": "Button Text", "default": "Get my ₹100 off" }
  ],
  "presets": [
    {
      "name": "Purelane Trust Elements"
    }
  ]
}
{% endschema %}
