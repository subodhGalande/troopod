{{ 'purelane.css' | asset_url | stylesheet_tag }}

<section class="sec" id="combos" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | escape }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
      <div class="rule"><i></i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg><i></i></div>
      <p class="lede" style="margin:14px auto 0">{{ section.settings.subtext | escape }}</p>
    </div>

    <div class="comborail rv">
      {%- for block in section.blocks -%}
        {% render 'combo-card-purelane', block: block %}
      {%- endfor -%}
    </div>
    
    <div class="swipecue" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
      Swipe for more combos
    </div>
    <p class="railnote">Tapping "Shop bundle" adds all these products to your cart instantly.</p>
  </div>
  
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const buttons = document.querySelectorAll('.purelane-combo-add');
      buttons.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          const variantData = this.getAttribute('data-variants');
          let variants = [];
          
          try {
            variants = JSON.parse(variantData);
          } catch(e) {
            console.error('Invalid variant data', e);
          }
          
          if (variants.length === 0) {
            alert('Please select products in the Theme Editor for this combo.');
            return;
          }
          
          const items = variants.map(function(id) {
            return { id: id, quantity: 1 };
          });
          
          const originalText = this.innerHTML;
          this.innerHTML = 'Adding...';
          this.style.opacity = '0.7';
          this.style.pointerEvents = 'none';
          
          fetch(window.Shopify.routes.root + 'cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: items })
          })
          .then(function(response) {
            return response.json();
          })
          .then(function(data) {
            window.location.href = window.Shopify.routes.root + 'cart';
          })
          .catch(function(error) {
            console.error('Error:', error);
            btn.innerHTML = originalText;
            btn.style.opacity = '1';
            btn.style.pointerEvents = 'auto';
            alert('Error adding bundle to cart.');
          });
        });
      });
    });
  </script>
</section>

