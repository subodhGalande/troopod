<section class="sec revband" id="reviews" data-scene="1">
  <div class="wrap">
    <div class="revhead rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <span class="agg"><span class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</span> <b>{{ section.settings.rating_score }}</b> {{ section.settings.rating_text }}</span>
      <span class="agg">{{ section.settings.social_proof }}</span>
    </div>
  </div>
  <div class="revrail rv" aria-label="Customer reviews">
    <div class="revtrack">
      {% for block in section.blocks %}
        {% render 'review-card-purelane', block: block %}
      {% endfor %}
      {% for block in section.blocks %}
        {% render 'review-card-purelane', block: block %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Reviews",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating Score",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "text",
      "id": "social_proof",
      "label": "Social Proof Text",
      "default": "Loved by <b>12 lakh+</b> homes"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "headline",
          "label": "Headline",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review Text",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product Name",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews Marquee",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "headline": "Works like a charm",
            "body": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.",
            "author": "Anita",
            "product_name": "Laundry detergent",
            "stars": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "headline": "Best dishwash ever",
            "body": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.",
            "author": "Priya",
            "product_name": "Dishwash gel",
            "stars": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "headline": "Great product, great packaging",
            "body": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.",
            "author": "Sunita",
            "product_name": "Liquid handwash",
            "stars": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "headline": "Dog friendly",
            "body": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.",
            "author": "Rohit S.",
            "product_name": "Floor cleaner",
            "stars": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "headline": "Sparkling taps again",
            "body": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.",
            "author": "Verified buyer",
            "product_name": "Tap cleaner",
            "stars": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}
