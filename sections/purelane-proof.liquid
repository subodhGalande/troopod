<section class="sec" id="proof" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="proof">
        <div class="proof-l">
          <span class="kicker">{{ section.settings.kicker }}</span>
          <h2 class="d2" style="margin-top:12px">{{ section.settings.title | newline_to_br }}</h2>
          <p class="body-s" style="max-width:40ch">{{ section.settings.text }}</p>
          {% if section.settings.button_label != blank %}
          <a class="btn btn-primary" href="{{ section.settings.button_link }}">
            {{ section.settings.button_label }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
          {% endif %}
        </div>

        {% assign product_blocks = section.blocks | where: "type", "product" %}
        {% if product_blocks.size > 0 %}
        <div class="glass-2 rot" id="rot" aria-hidden="true">
          <div class="frame">
            {% for block in product_blocks %}
              {% assign prod = all_products[block.settings.product] %}
              {% assign svg_class = block.settings.svg_icon %}
              {% if prod != blank %}
                <span class="pimg {{ svg_class }} {% if forloop.first %}on{% endif %}" role="img" aria-label="{{ prod.title | escape }}" data-name="{{ prod.title | escape }}" data-note="{{ block.settings.note | escape }}" {{ block.shopify_attributes }}></span>
              {% else %}
                <span class="pimg {{ svg_class }} {% if forloop.first %}on{% endif %}" role="img" data-name="Select product" data-note="{{ block.settings.note | escape }}" {{ block.shopify_attributes }}></span>
              {% endif %}
            {% endfor %}
          </div>
          <div class="cap">
            {% assign first_prod_block = product_blocks.first %}
            {% assign first_prod = all_products[first_prod_block.settings.product] %}
            <b>{{ first_prod.title | default: 'Select product' }}</b>
            <span>{{ first_prod_block.settings.note }}</span>
          </div>
          <div class="dots">
            {% for block in product_blocks %}
              <i class="{% if forloop.first %}on{% endif %}"></i>
            {% endfor %}
          </div>
        </div>
        {% endif %}
      </div>

      {% assign stat_blocks = section.blocks | where: "type", "stat" %}
      {% if stat_blocks.size > 0 %}
      <div class="glass-2 stats proof-stats" style="grid-column:1/-1">
        {% for block in stat_blocks %}
        <div class="stat" {{ block.shopify_attributes }}>
          <div class="ring">{{ block.settings.ring_text }}</div>
          <h5>{{ block.settings.title }}</h5>
          <p>{{ block.settings.text }}</p>
        </div>
        {% endfor %}
      </div>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Proof",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Why it works"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Tough on grime.\nGentle on everything else."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Every formula is built on plant-derived cleansers and essential oils. It behaves exactly like the cleaner you are used to, minus the things you never signed up for."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "See the ingredient list"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product Rotator Item",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "svg_icon",
          "label": "SVG Icon Class",
          "info": "e.g. p-kitchen, p-tap, p-laundry"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note",
          "default": "Foam lifts grease, no scrubbing"
        }
      ]
    },
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        {
          "type": "text",
          "id": "ring_text",
          "label": "Ring Text",
          "default": "99.9%"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Germ kill"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Tested against germs and bacteria"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Proof",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" }
      ]
    }
  ]
}
{% endschema %}
