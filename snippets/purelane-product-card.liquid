{% comment %}
  PURELANE PRODUCT CARD SNIPPET (1:1 PARITY WITH PROTOTYPE)
{% endcomment %}

{%- assign is_sold_out = false -%}
{%- unless product.available -%}
  {%- assign is_sold_out = true -%}
{%- endunless -%}

<article class="glass card">
  <div class="shot">
    {%- if is_sold_out -%}
      <span class="pill" style="border-color:#ff6b6b; color:#ff6b6b;">Sold out</span>
    {%- elsif badge_text != blank -%}
      <span class="pill">{{ badge_text }}</span>
    {%- else -%}
      <span class="pill">Best seller</span>
    {%- endif -%}

    {%- if product.featured_image != blank -%}
      <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy" width="400" height="400" class="pimg" style="height:122px; width:auto; object-fit:contain;">
    {%- else -%}
      <div style="text-align:center; color:var(--paper-3); font-size:11px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:32px; height:32px; margin:0 auto 4px; opacity:0.6;"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        <span>No image</span>
      </div>
    {%- endif -%}
  </div>

  <h4 style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; min-height:32px;" title="{{ product.title | escape }}">
    {{ product.title | escape }}
  </h4>

  <div class="rate">
    <b>★ 4.8</b> · 237 reviews
  </div>

  <div class="pr">
    <strong>{{ product.price | money }}</strong>
    {%- if product.compare_at_price > product.price -%}
      <s>{{ product.compare_at_price | money }}</s>
      {%- assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
      <em>{{ discount }}% off</em>
    {%- endif -%}
  </div>

  {%- form 'product', product, id: nil, class: 'product-form' -%}
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
    {%- if is_sold_out -%}
      <button type="button" class="btn btn-ghost btn-sm" disabled style="opacity:0.6; cursor:not-allowed; width:100%; justify-content:center;">
        Sold out
      </button>
    {%- else -%}
      <button type="submit" name="add" class="btn btn-ghost btn-sm" style="width:100%; justify-content:center;">
        Add to cart
      </button>
    {%- endif -%}
  {%- endform -%}
</article>
